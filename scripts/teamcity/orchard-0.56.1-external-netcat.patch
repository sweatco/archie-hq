diff --git a/internal/dialer/externalnetcat.go b/internal/dialer/externalnetcat.go
new file mode 100644
index 0000000..8bfb3f4
--- /dev/null
+++ b/internal/dialer/externalnetcat.go
@@ -0,0 +1,160 @@
+package dialer
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"os/exec"
+	"strings"
+	"sync"
+	"time"
+)
+
+type externalNetcatConn struct {
+	stdin  io.WriteCloser
+	stdout io.ReadCloser
+	cmd    *exec.Cmd
+	done   chan error
+	once   sync.Once
+}
+
+func ExternalNetcat() Dialer {
+	return DialFunc(dialExternalNetcat)
+}
+
+func dialExternalNetcat(ctx context.Context, network, addr string) (net.Conn, error) {
+	if err := context.Cause(ctx); err != nil {
+		return nil, err
+	}
+	if network != "tcp" && network != "tcp4" && network != "tcp6" {
+		return nil, fmt.Errorf("external netcat dialer does not support network %q", network)
+	}
+
+	host, port, err := net.SplitHostPort(addr)
+	if err != nil {
+		return nil, fmt.Errorf("external netcat dialer: %w", err)
+	}
+
+	cmd := exec.Command("/usr/bin/nc", "-v", "-G", "5", host, port)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		return nil, err
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		_ = stdin.Close()
+		return nil, err
+	}
+	stderr, err := cmd.StderrPipe()
+	if err != nil {
+		_ = stdin.Close()
+		_ = stdout.Close()
+		return nil, err
+	}
+	if err := cmd.Start(); err != nil {
+		_ = stdin.Close()
+		_ = stdout.Close()
+		return nil, err
+	}
+
+	conn := &externalNetcatConn{
+		stdin:  stdin,
+		stdout: stdout,
+		cmd:    cmd,
+		done:   make(chan error, 1),
+	}
+	go func() {
+		conn.done <- cmd.Wait()
+		close(conn.done)
+	}()
+	connected := make(chan struct{})
+	go func() {
+		scanner := bufio.NewScanner(stderr)
+		for scanner.Scan() {
+			if strings.Contains(strings.ToLower(scanner.Text()), "succeeded") {
+				close(connected)
+				return
+			}
+		}
+	}()
+	select {
+	case <-connected:
+		return conn, nil
+	case err := <-conn.done:
+		_ = stdin.Close()
+		_ = stdout.Close()
+		if err == nil {
+			err = io.EOF
+		}
+		return nil, fmt.Errorf("external netcat dialer failed to reach %s: %w", addr, err)
+	case <-ctx.Done():
+		_ = cmd.Process.Kill()
+		<-conn.done
+		_ = stdin.Close()
+		_ = stdout.Close()
+		return nil, context.Cause(ctx)
+	}
+}
+
+func (conn *externalNetcatConn) Read(buffer []byte) (int, error) {
+	return conn.stdout.Read(buffer)
+}
+
+func (conn *externalNetcatConn) Write(buffer []byte) (int, error) {
+	return conn.stdin.Write(buffer)
+}
+
+func (conn *externalNetcatConn) Close() error {
+	var result error
+	conn.once.Do(func() {
+		stdinErr := conn.stdin.Close()
+		stdoutErr := conn.stdout.Close()
+		killErr := conn.cmd.Process.Kill()
+		waitErr := <-conn.done
+		if errors.Is(killErr, os.ErrProcessDone) {
+			killErr = nil
+		}
+		if _, ok := waitErr.(*exec.ExitError); ok {
+			waitErr = nil
+		}
+		result = errors.Join(stdinErr, stdoutErr, killErr, waitErr)
+	})
+	return result
+}
+
+func (conn *externalNetcatConn) LocalAddr() net.Addr {
+	return externalNetcatAddr("external-netcat")
+}
+
+func (conn *externalNetcatConn) RemoteAddr() net.Addr {
+	return externalNetcatAddr("external-netcat")
+}
+
+func (conn *externalNetcatConn) SetDeadline(deadline time.Time) error {
+	return errors.Join(setFileDeadline(conn.stdout, deadline), setFileDeadline(conn.stdin, deadline))
+}
+
+func (conn *externalNetcatConn) SetReadDeadline(deadline time.Time) error {
+	return setFileDeadline(conn.stdout, deadline)
+}
+
+func (conn *externalNetcatConn) SetWriteDeadline(deadline time.Time) error {
+	return setFileDeadline(conn.stdin, deadline)
+}
+
+func setFileDeadline(stream any, deadline time.Time) error {
+	file, ok := stream.(*os.File)
+	if !ok {
+		return os.ErrNoDeadline
+	}
+	return file.SetDeadline(deadline)
+}
+
+type externalNetcatAddr string
+
+func (addr externalNetcatAddr) Network() string { return "tcp" }
+func (addr externalNetcatAddr) String() string  { return string(addr) }
diff --git a/internal/dialer/externalnetcat_test.go b/internal/dialer/externalnetcat_test.go
new file mode 100644
index 0000000..8072ddf
--- /dev/null
+++ b/internal/dialer/externalnetcat_test.go
@@ -0,0 +1,77 @@
+package dialer
+
+import (
+	"context"
+	"io"
+	"net"
+	"runtime"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestExternalNetcat(t *testing.T) {
+	if runtime.GOOS != "darwin" {
+		t.Skip("the lab dialer uses the macOS netcat CLI")
+	}
+
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer listener.Close()
+
+	go func() {
+		connection, acceptErr := listener.Accept()
+		if acceptErr != nil {
+			return
+		}
+		defer connection.Close()
+		_, _ = io.Copy(connection, connection)
+	}()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	connection, err := ExternalNetcat().DialContext(ctx, "tcp", listener.Addr().String())
+	require.NoError(t, err)
+	cancel()
+
+	require.NoError(t, connection.SetDeadline(time.Now().Add(time.Second)))
+	_, err = connection.Write([]byte("orchard-lab"))
+	require.NoError(t, err)
+	received := make([]byte, len("orchard-lab"))
+	_, err = io.ReadFull(connection, received)
+	require.NoError(t, err)
+	require.Equal(t, "orchard-lab", string(received))
+	require.NoError(t, connection.Close())
+	require.NoError(t, connection.Close())
+}
+
+func TestExternalNetcatRefused(t *testing.T) {
+	if runtime.GOOS != "darwin" {
+		t.Skip("the lab dialer uses the macOS netcat CLI")
+	}
+
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	address := listener.Addr().String()
+	require.NoError(t, listener.Close())
+
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	connection, err := ExternalNetcat().DialContext(ctx, "tcp", address)
+	require.Error(t, err)
+	require.Nil(t, connection)
+}
+
+func TestExternalNetcatCancellation(t *testing.T) {
+	if runtime.GOOS != "darwin" {
+		t.Skip("the lab dialer uses the macOS netcat CLI")
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	started := time.Now()
+	connection, err := ExternalNetcat().DialContext(ctx, "tcp", "203.0.113.1:65000")
+	require.ErrorIs(t, err, context.Canceled)
+	require.Nil(t, connection)
+	require.Less(t, time.Since(started), time.Second)
+}
