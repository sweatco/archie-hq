# Dependencies
node_modules/
npm-debug.log
yarn-error.log
yarn.lock

# Build outputs
dist/
build/
*.js
*.js.map
*.d.ts
!*.config.js

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.*.local

# GitHub App private keys
*.pem

# Runtime OAuth tokens (encrypted, but never commit)
secrets/oauth/

# Plugin-supplied credential files in the secrets volume
secrets/*-credentials.json

# Runtime data
workdir
claude-data
*.log

# OS
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/

# Git worktrees
.worktrees/

# Local E2E evidence (Forge Stage 4 targets qa-evidence/ explicitly instead)
e2e-evidence/

# voice-cases harness run output (see tools/voice-cases/README.md) — logs are
# already covered by *.log above, this covers the graded result JSON
tools/voice-cases/results/

# Local data snapshots pulled by scripts/pull-remote-data.sh
archie-data-*
*.partial.*
secrets/extra-ca.crt
*.bak
workdir.pre-e2e/
