# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Claude Code CLI path - point directly to cli.js
CLAUDE_PATH=/path/to/claude

# Slack Configuration (optional — omit for CLI-only mode)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# Set SLACK_APP_TOKEN (xapp-...) to use Socket Mode instead of HTTP webhooks.
# Requires `connections:write` scope on an app-level token. When set, no public
# webhook URL is needed — events flow over an outbound WebSocket.
# SLACK_APP_TOKEN=xapp-...

# Live "Archie is …" status indicator while a task is working. Surface-agnostic:
# the same line is rendered to the CLI and (best-effort) the Slack assistant-
# thread loading state. DEFAULTS ON; set to 'false' to disable on all surfaces.
# Slack rendering additionally needs assistant:write or chat:write (both in the
# manifest) and the Agents & AI Apps toggle on the bot.
ARCHIE_LIVE_STATUS=true

# Max mode (per-task, human-approved model/effort upgrade for coding agents).
# OPTIONAL fallbacks for REPO / DYNAMIC agents that don't set their own
# `metadata.archie.maxMode` in the plugins repo — notably dynamic agents, which
# are synthesized at runtime and have no frontmatter file. They never affect
# generic plugin agents or the PM, and a per-agent frontmatter maxMode always
# wins. See docs/architecture/max-mode.md.
# ARCHIE_MAX_MODE_MODEL=claude-fable-5
# ARCHIE_MAX_MODE_EFFORT=max

# Working directory (all state lives here: plugins, repos, sessions)
# Default: ./workdir
# ARCHIE_WORKDIR=./workdir

# Plugins repo (git URL — cloned into $ARCHIE_WORKDIR/plugins on startup).
# If unset, $ARCHIE_WORKDIR/plugins must already exist (e.g. a local checkout or
# symlink). To try the bundled example plugins, leave this UNSET and run
# `npm run example:setup` (symlinks examples/plugins -> workdir/plugins).
# To use your own plugins, set this to their git URL:
# ARCHIE_PLUGINS=https://github.com/your-org/your-plugins-repo.git

# Memory layer (auto-learns from completed tasks). Injection into prompts is a
# separate, default-off gate — see ARCHIE_MEMORY_INJECT below.
# Set to 'false' to disable the whole layer (both extraction and injection).
ARCHIE_MEMORY=true

# Memory injection (read path): inject stored facts into agent prompts.
# Independent of extraction and DEFAULTS OFF (opposite of the other flags here).
# Leave unset/false to collect & evaluate facts without changing agent behavior;
# set to 'true' to actually inject memory. ARCHIE_MEMORY=false overrides this.
ARCHIE_MEMORY_INJECT=false

# Memory housekeeping (periodic Sonnet pass merges duplicates, drops stale entries)
# Set to 'false' to disable both automatic and manual housekeeping
ARCHIE_MEMORY_HOUSEKEEPING=true
# Per-user total-bullet soft cap; consolidation auto-triggers when exceeded
ARCHIE_MEMORY_USER_CAP=100
# Per-section soft cap
ARCHIE_MEMORY_SECTION_CAP=30
# Days after which an unrefreshed bullet becomes eligible for removal
ARCHIE_MEMORY_STALENESS_DAYS=180
# Entity layer: soft cap on total entity pages; entity housekeeping (merge/archive) auto-triggers when exceeded
ARCHIE_MEMORY_ENTITY_CAP=300
# Max full entity pages pushed into a single agent prompt (the thin index is always injected in full)
ARCHIE_MEMORY_ENTITY_INJECT_MAX=8

# GitHub App (for PR management)
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=archie-hq
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-private-key.pem
GITHUB_INSTALLATION_ID=12345678
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# GitHub account Archie is credited as (USER id, not the App ID)
ARCHIE_GITHUB_LOGIN=archie-hq
ARCHIE_GITHUB_USER_ID=302249786
ARCHIE_GITHUB_NAME=Archie HQ

# MCP Plugin Servers
# Any `${MCP_*}` placeholder in your plugins repo's `.mcp.json` is substituted
# from the environment at load time. Which keys you need is entirely a property
# of your plugins — the engine reads none of them by name, so none are listed
# here. Declare the ones your servers reference (e.g. MCP_FOO_TOKEN=...) in your
# own `.env`, and document them alongside the plugins that consume them.

# OAuth-based MCP servers
# Generate the key once and append it directly to .env so the value
# never hits stdout or shell history (prefix with a space when
# HIST_IGNORE_SPACE is on):
#   echo "ARCHIE_SECRETS_KEY=$(openssl rand -base64 32 | tr -d '\n')" >> .env
# Required when any OAuth records exist; the CLI also requires it.
ARCHIE_SECRETS_KEY=
# Public HTTPS URL where the daemon is reachable. The OAuth provider
# redirects browsers to ${ARCHIE_PUBLIC_URL}/oauth/callback after
# the operator authorizes. Required to run `oauth:connect`.
ARCHIE_PUBLIC_URL=
# Override for the secrets directory. Default: /app/secrets in container,
# <repo>/secrets locally.
# ARCHIE_SECRETS_DIR=

# Server Configuration
PORT=3000

# ---- Voice participant (optional) ----
# Archie joins a Zoom meeting as a participant, listens, and answers when
# addressed by name. Disabled unless RECALL_API_KEY, DEEPGRAM_API_KEY,
# SONIOX_API_KEY, CEREBRAS_API_KEY and ARCHIE_PUBLIC_URL are all set. Recall
# dials back into us over WebSocket and loads a page from us as the bot's
# camera, so the public URL must be reachable.
RECALL_API_KEY=
# Recall regions are separate deployments with separate credentials:
# us-east-1, us-west-2 (pay-as-you-go), eu-central-1, ap-northeast-1
RECALL_REGION=eu-central-1
DEEPGRAM_API_KEY=
# Deepgram host for Flux, which does the listening. Default is the global
# endpoint. `api.eu.deepgram.com` measured ~150ms faster per exchange and
# ~300ms faster on socket setup from a European machine, and is the more stable of
# the two — but it is a real regression from a US-hosted engine, and where
# production runs has not been established, so this is left as a knob rather than
# a default. It is also a privacy choice, not only a latency one: this bot records
# colleagues who never agreed to anything with Deepgram.
# DEEPGRAM_HOST=api.eu.deepgram.com
# Languages spoken in your meetings, comma-separated (e.g. `en,ru`). Biases the
# speech model toward them instead of letting it guess per utterance. Empty by
# default, which leaves auto-detection on — there is no default list because which
# languages a room speaks is a property of your team, not of the bot.
#
# Set it if your meetings are not in English. Auto-detection does not degrade
# gracefully: in a live Russian meeting it returned whole utterances as French and
# as Portuguese, which the bot could only answer with "I didn't catch that".
# Hinting the languages you actually speak fixes that and costs English nothing —
# measured identical with and without. Supported: en, es, fr, de, hi, ru, pt, ja,
# it, nl. Codes are NOT validated by Deepgram, so a typo silently buys you
# nothing; check `languages_hinted` in the Flux logs if in doubt.
# ARCHIE_VOICE_LANGUAGE_HINTS=en,ru
# Name the bot joins under, and the name people say to summon it
ARCHIE_VOICE_BOT_NAME=Archie
# Required. Cerebras `gemma-4-31b` answers the comprehension calls (addressing
# gate, and what to say). It measured ~3x faster to its first
# sentence than Claude Haiku 4.5 at the same cost per call, and scored higher on
# a 16-case suite over the real prompts.
CEREBRAS_API_KEY=
# Required. Soniox `tts-rt-v2`, voice `Adrian`, speaks every answer. Not a
# latency choice: the language is a separate field from the voice, so one voice
# answers in either English or Russian and a Russian sentence carrying English
# technical terms comes out native. Set ARCHIE_VOICE_LANGUAGE_HINTS too — the
# synthesizer picks its language from the reply text, but the transcript it is
# replying to still comes from Flux.
# Soniox is also what makes an interrupted answer recordable: it opens one
# stream per sentence, so the meeting can know which sentences the room actually
# heard before somebody spoke over them.
SONIOX_API_KEY=
# Soniox host. Default is the US endpoint, which is the only region the current
# key authenticates against — EU and JP are separate deployments with separate
# credentials and answer 401. EU measured much closer from Europe (socket open
# ~160-197ms against ~316-450ms), so switch both this and DEEPGRAM_HOST together
# once an EU key exists, or a live run's latency figures mix two continents.
# SONIOX_HOST=tts-rt.eu.soniox.com
